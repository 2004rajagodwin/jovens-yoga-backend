# Copy to .env in this same directory (jovens-yoga-backend/.env) and fill in real values.
# .env is gitignored and loaded automatically by application.properties via
# spring.config.import — NEVER commit a real .env file, and NEVER put real secret
# values in this .env.example template.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/jovens_yoga
DB_USERNAME=root
DB_PASSWORD=

# --- JWT (admin auth) ---
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=480

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Stripe (TEST MODE keys only for local dev) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/payment/success
STRIPE_CANCEL_URL=http://localhost:5173/payment/cancelled

# --- Email (SMTP - Gmail) ---
# SMTP_PASSWORD must be a Gmail App Password (https://myaccount.google.com/apppasswords),
# NOT your normal Gmail account password. Requires 2-Step Verification enabled on the account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM_ADDRESS=no-reply@jovensyoga.com
MAIL_FROM_NAME=Jovens Yoga

# --- Frontend (used to build Buy Plan links in emails) ---
FRONTEND_BASE_URL=http://localhost:5173

# --- AskEva WhatsApp ---
ASKEVA_API_URL=
ASKEVA_API_KEY=
ASKEVA_TEMPLATE_ID=

# --- Trial configuration ---
TRIAL_DEFAULT_DURATION_DAYS=5
TRIAL_REMINDER_DAYS=1,2,3,4,5
# Cron expressions (Spring 6-field: sec min hour day month weekday)
TRIAL_REMINDER_CRON=0 0 * * * *
TRIAL_EXPIRY_CRON=0 15 * * * *

# --- Initial admin account (created on startup if no admin with this username exists yet) ---
ADMIN_SEED_USERNAME=Jovensyoga2026
ADMIN_SEED_NAME=Jovens Yoga Admin
# Set this locally to seed the initial admin password. Never commit a real value here.
ADMIN_SEED_PASSWORD=
